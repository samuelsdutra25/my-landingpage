{
  "name": "landingpage-samuel",
  "private": true,
  "description": "Single-page portfolio landing site for Samuel Dutra",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o assets/tailwind.css --minify",
    "watch": "tailwindcss -i src/input.css -o assets/tailwind.css --watch",
    "vendor:gsap": "cp node_modules/gsap/dist/gsap.min.js assets/gsap.min.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3"
  }
}
