{
  "name": "landingpage-samuel",
  "private": true,
  "description": "Single-page portfolio landing site for Samuel Dutra",
  "scripts": {
    "build": "npm run build:css && npm run build:html",
    "build:css": "tailwindcss -i src/input.css -o assets/tailwind.css --minify",
    "build:html": "node scripts/build-html.mjs",
    "watch": "tailwindcss -i src/input.css -o assets/tailwind.css --watch",
    "vendor:gsap": "cp node_modules/gsap/dist/gsap.min.js node_modules/gsap/dist/ScrollToPlugin.min.js assets/"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3"
  }
}
